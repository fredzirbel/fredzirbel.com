{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fredzirbel-com",
  "compatibility_date": "2026-11-26",
  // Production is served only on the custom domain. Preview URLs stay
  // available and Cloudflare marks them noindex automatically.
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
